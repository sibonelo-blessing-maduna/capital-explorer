# Copy this file to .env (which is gitignored) and fill in real values.
# Never commit the real .env file.

PORT=3001

# A long random string. Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# --- Admin account (email + password login, not Google) --------------------
# Seeded once on first server start (server/src/seed.ts). Change the password
# here and restart to rotate it; the seeder is idempotent and will not
# overwrite an existing account's password on subsequent starts — delete the
# user's row in server/data/app.db first if you need to force a reset.
ADMIN_SEED_EMAIL=you@example.com
ADMIN_SEED_PASSWORD=choose-a-strong-password

# --- Google OAuth (regular user sign-in) ------------------------------------
# From https://console.cloud.google.com/apis/credentials — see DEPLOY.md
# "Setting up Google OAuth" for the exact steps. Leave unset during local
# development if you just want to test the admin login path; the "Continue
# with Google" button will show as disabled until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match one of the "Authorized redirect URIs" in the Google
# Cloud Console credential, e.g. http://localhost:3001/api/auth/google/callback
# in development or https://yourdomain.com/api/auth/google/callback in prod.
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- Production-only ---------------------------------------------------------
# Set automatically by most hosts; only needed if yours doesn't.
# NODE_ENV=production

# Only set this to false if you are running a production build locally over
# plain HTTP for testing, or if your host's proxy doesn't correctly forward
# HTTPS detection to this app (see ARCHITECTURE.md, index.ts's COOKIE_SECURE
# comment, for exactly what symptom that causes and why). Leave unset in a
# real deployment behind HTTPS.
# COOKIE_SECURE=false

# Only needed in local development, where the Vite dev server (client) runs
# on a different port than this API server — enables permissive CORS for
# that one origin. Not used in production (client is served from this same
# process and origin).
# CLIENT_ORIGIN=http://localhost:5173
